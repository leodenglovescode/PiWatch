# Generic installation template. Existing local install/update scripts preserve the live radio unit.
# Provision the service user, interpreter, and source paths below before installing this template.
[Unit]
Description=Meshtastic LoRa Notification API
After=network.target

[Service]
Type=simple
StateDirectory=lora-notifyd
StateDirectoryMode=0700
TimeoutStopSec=150
User=piwatch-radio
Group=piwatch-radio
SupplementaryGroups=dialout

EnvironmentFile=/etc/lora-notifyd.env
Environment=PYTHONUNBUFFERED=1

ExecStart=/opt/piwatch-radio/bin/python /usr/local/lib/piwatch/lora/lora-notifyd.py

Restart=always
RestartSec=5

WorkingDirectory=/usr/local/lib/piwatch/lora

[Install]
WantedBy=multi-user.target
