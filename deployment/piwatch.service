[Unit]
Description=PiWatch Server Monitoring Daemon
Wants=network-online.target lora-notifyd.service
After=network-online.target lora-notifyd.service

[Service]
Type=simple
StateDirectory=piwatch
StateDirectoryMode=0700
TimeoutStopSec=150

User=piwatch
Group=piwatch

ExecStart=/usr/bin/python3 /usr/local/lib/piwatch/piwatchd.py

Restart=always
RestartSec=2

RuntimeDirectory=piwatch
RuntimeDirectoryMode=0755

EnvironmentFile=/etc/piwatch/secrets.env
Environment=PYTHONUNBUFFERED=1

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true

[Install]
WantedBy=multi-user.target
